<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Tao Construction — Master Bricklayer</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=Lato:wght@300;400;700&display=swap" rel="stylesheet">
<style>
  :root {
    --clay: #c1440e;
    --sand: #e8d5b7;
    --cream: #faf6f0;
    --charcoal: #2c2c2c;
    --warm-gray: #8b7355;
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Lato', sans-serif; background: var(--cream); color: var(--charcoal); }

  /* NAV */
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    display: flex; justify-content: space-between; align-items: center;
    padding: 1.2rem 5%; background: rgba(250,246,240,0.95);
    backdrop-filter: blur(8px); border-bottom: 1px solid var(--sand);
  }
  .logo { font-family: 'Playfair Display', serif; font-size: 1.4rem; color: var(--clay); font-weight: 900; }
  .nav-links { display: flex; gap: 2rem; list-style: none; }
  .nav-links a { text-decoration: none; color: var(--charcoal); font-size: 0.85rem; letter-spacing: 1.5px; text-transform: uppercase; transition: color 0.3s; }
  .nav-links a:hover { color: var(--clay); }

  /* HERO */
  .hero {
    min-height: 100vh; display: flex; align-items: center;
    padding: 6rem 5% 4rem;
    background: linear-gradient(135deg, var(--cream) 60%, var(--sand) 100%);
    position: relative; overflow: hidden;
  }
  .hero::before {
    content: ''; position: absolute; right: -5%; top: 10%;
    width: 55%; height: 80%; border-radius: 2px;
    background: repeating-linear-gradient(45deg, var(--clay) 0, var(--clay) 2px, transparent 2px, transparent 20px),
                repeating-linear-gradient(-45deg, var(--clay) 0, var(--clay) 2px, transparent 2px, transparent 20px);
    opacity: 0.06;
  }
  .hero-content { max-width: 580px; position: relative; z-index: 2; }
  .hero-tag { font-size: 0.75rem; letter-spacing: 3px; text-transform: uppercase; color: var(--clay); margin-bottom: 1.2rem; display: flex; align-items: center; gap: 0.8rem; }
  .hero-tag::before { content: ''; display: block; width: 40px; height: 2px; background: var(--clay); }
  h1 { font-family: 'Playfair Display', serif; font-size: clamp(3rem, 6vw, 5.5rem); line-height: 1.05; color: var(--charcoal); margin-bottom: 1.5rem; }
  h1 span { color: var(--clay); }
  .hero p { font-size: 1.05rem; color: var(--warm-gray); line-height: 1.8; max-width: 440px; margin-bottom: 2.5rem; }
  .hero-btns { display: flex; gap: 1rem; flex-wrap: wrap; }
  .btn { display: inline-block; padding: 0.9rem 2rem; font-size: 0.85rem; letter-spacing: 1.5px; text-transform: uppercase; text-decoration: none; border: none; cursor: pointer; transition: all 0.3s; font-family: 'Lato', sans-serif; }
  .btn-primary { background: var(--clay); color: white; }
  .btn-primary:hover { background: #a33a0c; transform: translateY(-2px); }
  .btn-outline { background: transparent; color: var(--charcoal); border: 2px solid var(--charcoal); }
  .btn-outline:hover { background: var(--charcoal); color: white; }

  /* STATS */
  .stats { background: var(--charcoal); padding: 3rem 5%; display: flex; justify-content: center; gap: 4rem; flex-wrap: wrap; }
  .stat { text-align: center; }
  .stat-num { font-family: 'Playfair Display', serif; font-size: 2.8rem; color: var(--clay); font-weight: 900; }
  .stat-label { font-size: 0.75rem; letter-spacing: 2px; text-transform: uppercase; color: #aaa; margin-top: 0.3rem; }

  /* SECTIONS */
  section { padding: 5rem 5%; }
  .section-tag { font-size: 0.75rem; letter-spacing: 3px; text-transform: uppercase; color: var(--clay); margin-bottom: 0.8rem; }
  h2 { font-family: 'Playfair Display', serif; font-size: clamp(2rem, 4vw, 3rem); color: var(--charcoal); margin-bottom: 1rem; }
  .section-sub { color: var(--warm-gray); line-height: 1.8; max-width: 500px; margin-bottom: 3rem; }

  /* SERVICES */
  .services { background: var(--cream); }
  .services-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.5rem; }
  .service-card {
    background: white; padding: 2rem; border-left: 4px solid var(--clay);
    transition: transform 0.3s, box-shadow 0.3s;
  }
  .service-card:hover { transform: translateY(-4px); box-shadow: 0 12px 30px rgba(0,0,0,0.08); }
  .service-icon { font-size: 2rem; margin-bottom: 1rem; }
  .service-card h3 { font-family: 'Playfair Display', serif; font-size: 1.2rem; margin-bottom: 0.6rem; }
  .service-card p { font-size: 0.9rem; color: var(--warm-gray); line-height: 1.7; }
  
/* GALLERY - UPGRADED */
.gallery {
  background: var(--sand);
}

.gallery-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1.2rem;
}

.gallery-item {
  position: relative;
  height: 260px;
  border-radius: 6px;
  overflow: hidden;
  cursor: pointer;
  background-size: cover;
  background-position: center;
  transition: transform 0.35s ease, box-shadow 0.35s ease;
}

.gallery-item:hover {
  transform: translateY(-6px) scale(1.01);
  box-shadow: 0 18px 40px rgba(0,0,0,0.15);
}

.gallery-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.85), rgba(0,0,0,0.2));
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 1.2rem;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.gallery-item:hover .gallery-overlay {
  opacity: 1;
}

.gallery-overlay h3 {
  font-family: 'Playfair Display', serif;
  font-size: 1.1rem;
  color: #fff;
  margin-bottom: 0.3rem;
}

.gallery-overlay p {
  font-size: 0.8rem;
  color: #ddd;
}
  
  /* BOOKING */
  .booking { background: white; }
  .booking-wrap { display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: start; }
  .booking-info h2 { margin-bottom: 1rem; }
  .booking-info p { color: var(--warm-gray); line-height: 1.8; margin-bottom: 1.5rem; }
  .contact-item { display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem; }
  .contact-item .icon { width: 42px; height: 42px; background: var(--clay); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .contact-item .icon span { font-size: 1.1rem; }
  .contact-item p { font-size: 0.9rem; color: var(--charcoal); }
  .contact-item small { color: var(--warm-gray); font-size: 0.8rem; }

  form { display: flex; flex-direction: column; gap: 1rem; }
  form input, form select, form textarea {
    padding: 0.9rem 1.1rem; border: 1px solid #e0d8cc; background: var(--cream);
    font-family: 'Lato', sans-serif; font-size: 0.9rem; color: var(--charcoal);
    outline: none; transition: border-color 0.3s;
  }
  form input:focus, form select:focus, form textarea:focus { border-color: var(--clay); }
  form textarea { resize: vertical; min-height: 100px; }
  .wa-btn {
    background: #25D366; color: white; border: none; padding: 1rem;
    font-size: 0.85rem; letter-spacing: 1.5px; text-transform: uppercase;
    cursor: pointer; font-family: 'Lato', sans-serif;
    display: flex; align-items: center; justify-content: center; gap: 0.7rem;
    transition: background 0.3s;
  }
  .wa-btn:hover { background: #1ebe5b; }

  /* TESTIMONIALS */
  .testimonials { background: var(--cream); }
  .testimonials-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; }
  .testimonial-card { background: white; padding: 2rem; border-top: 3px solid var(--clay); }
  .testimonial-card p { font-size: 0.95rem; line-height: 1.8; color: var(--warm-gray); margin-bottom: 1.2rem; font-style: italic; }
  .testimonial-author { font-weight: 700; font-size: 0.85rem; color: var(--charcoal); }
  .stars { color: var(--clay); margin-bottom: 0.8rem; }

  /* FOOTER */
  footer { background: var(--charcoal); color: #aaa; text-align: center; padding: 2rem; font-size: 0.85rem; }
  footer span { color: var(--clay); }

  @media(max-width: 768px) {
    .booking-wrap { grid-template-columns: 1fr; gap: 2rem; }
    .gallery-grid { grid-template-columns: repeat(2, 1fr); grid-template-rows: auto; }
    .gallery-item:first-child { grid-row: span 1; }
    .nav-links { display: none; }
  }
</style>
</head>
