<script>
  // Set min date to today
  document.getElementById('date').min = new Date().toISOString().split('T')[0];

  document.getElementById('bookingForm').addEventListener('submit', function(e) {
    e.preventDefault();
    const name = document.getElementById('name').value;
    const phone = document.getElementById('phone').value;
    const service = document.getElementById('service').value;
    const location = document.getElementById('location').value;
    const date = document.getElementById('date').value;
    const details = document.getElementById('details').value;

    // ⚠️ REPLACE with the bricklayer's actual WhatsApp number (with country code, no + or spaces)
    const waNumber = '2349038573936';

    const message = `Hello Tao Construction! I'd like to book a job. 🧱

*Name:* ${name}
*My Phone:* ${phone}
*Service Needed:* ${service}
*Job Location:* ${location}
*Preferred Date:* ${date || 'Flexible'}
*Additional Details:* ${details || 'None'}

Please confirm availability. Thank you!`;

    window.open(`https://wa.me/${2349038573936}?text=${encodeURIComponent(message)}`, '_blank');
  });
</script>
